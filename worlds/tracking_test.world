<?xml version="1.0"?>
<sdf version="1.6">
  <world name="tracking_test">
    <gravity>0 0 -9.81</gravity>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Self-contained ground and lighting: no online model downloads. -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_obstacle">
      <static>true</static>
      <pose>2 2 1 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.5 0.5 2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.5 0.5 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.3 0.2 1</ambient>
            <diffuse>0.7 0.3 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="pillar_obstacle">
      <static>true</static>
      <pose>4 1 1 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.5 0.5 2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.5 0.5 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.5 0.7 1</ambient>
            <diffuse>0.2 0.5 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_obstacle">
      <static>true</static>
      <pose>4 3 1 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.5 0.5 2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.5 0.5 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Ground image marks the takeoff origin; lift slightly to avoid z-fighting. -->
    <include>
      <uri>model://A_H</uri>
      <name>takeoff_marker</name>
      <pose>0 0 0.01 0 0 0</pose>
    </include>

    <!-- Moving ArUco target: DICT_4X4_50, ID 0, black square side 0.375 m
         on a 0.5 m panel with white margins. Motion is configured in sim_world.yaml. -->
    <include>
      <uri>model://tracking_target</uri>
      <name>tracking_target</name>
      <pose>-2 2 0.02 0 1.57079632679 0</pose>
    </include>

    <gui>
      <camera name="user_camera">
        <pose>-9 -9 7 0 0.4 0.7</pose>
      </camera>
    </gui>
  </world>
</sdf>
