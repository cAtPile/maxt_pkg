<root main_tree_to_execute="Test1114B">
    <!-- A 的经纬度是仿真示例；实飞前替换。B 沿配置航向前进 5 m。 -->
    <BehaviorTree ID="Test1114B">
        <Sequence>
            <ConnectCheck />
            <Takeoff target_alt="3.0" home_x="{home_x}" home_y="{home_y}"
                     home_z="{home_z}" return_z="{return_z}" />
            <ReHeading timeout="60.0" />
            <BasePointAzimuthFix bp_x_raw="{bp_x_raw}" bp_y_raw="{bp_y_raw}" bp_z_raw="{bp_z_raw}" />
            <NavAzimuth nav_n="5.0" nav_t="0" nav_a="0"
                        bp_x_raw="{bp_x_raw}" bp_y_raw="{bp_y_raw}" bp_z_raw="{bp_z_raw}" timeout="60.0" />
            <Hover hover_duration="5.0" />
            <Nav x="{home_x}" y="{home_y}" z="{return_z}" timeout="90.0" />
            <TouchDown />
        </Sequence>
    </BehaviorTree>
</root>
