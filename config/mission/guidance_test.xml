<root main_tree_to_execute="GuidanceTest">
    <BehaviorTree ID="GuidanceTest">
        <Sequence>
            <ConnectCheck />
            <Takeoff target_alt="1.0" />
            <Hover hover_duration="2.0" />
            <!-- 本测试预期超时失败，继续执行降落。 -->
            <ForceSuccess>
                <Guidance target_id="test"
                          timeout="15.0"
                          message="{guidance_message}" />
            </ForceSuccess>
            <TouchDown />
        </Sequence>
    </BehaviorTree>
</root>
