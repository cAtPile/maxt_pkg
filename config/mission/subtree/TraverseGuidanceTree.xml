<root>
    <include path="TraverseDetectTree.xml" />
    <!-- 输入：区域原点偏移 origin_x/y、有符号边长 length_x/y、航带间距 coverage_step，
         固定原始本地基点 bp_x_raw/y_raw/z_raw、相对基点高度 height_above_base，
         tracking_duration（秒，0 表示对齐一次）。调用前应完成起飞和基点采集。
         区域 +X 对应 nav_n，+Y 对应 nav_t（左侧），方向使用 nav/azimuth_angle。
         输出：result=complete/failed、detected_target_id、guidance_message。
         先规划轨迹，再逐点调用 TraverseDetectTree；任一航点处理失败立即结束。
         所有航点共用固定基点，不负责起飞、返航或降落。 -->
    <BehaviorTree ID="TraverseGuidanceTree">
        <Sequence>
            <SetBlackboard output_key="result" value="failed" />
            <TraversePathGenerator origin_x="{origin_x}" origin_y="{origin_y}"
                                   length_x="{length_x}" length_y="{length_y}"
                                   coverage_step="{coverage_step}"
                                   waypoints="{region_waypoints}"
                                   waypoint_count="{region_waypoint_count}" />
            <SetBlackboard output_key="region_waypoint_index" value="0" />
            <Repeat num_cycles="{region_waypoint_count}">
                <Sequence>
                    <GetRegionWaypoint waypoints="{region_waypoints}"
                                       index="{region_waypoint_index}"
                                       next_index="{region_waypoint_index}"
                                       x="{region_target_x}" y="{region_target_y}" />
                    <SubTreePlus ID="TraverseDetectTree"
                                 nav_n="{region_target_x}" nav_t="{region_target_y}"
                                 nav_a="{height_above_base}"
                                 bp_x_raw="{bp_x_raw}" bp_y_raw="{bp_y_raw}"
                                 bp_z_raw="{bp_z_raw}"
                                 tracking_duration="{tracking_duration}"
                                 result="{waypoint_result}"
                                 detected_target_id="{detected_target_id}"
                                 guidance_message="{guidance_message}" />
                </Sequence>
            </Repeat>
            <SetBlackboard output_key="result" value="complete" />
        </Sequence>
    </BehaviorTree>
</root>
