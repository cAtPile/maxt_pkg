<root>
    <!-- 输入：原点 origin_x/y、有符号边长 length_x/y、航带间距 coverage_step、导航高度 altitude。
         输出：result = found / complete / failed。
         规划、导航失败返回 FAILURE；发现目标或遍历完成返回 SUCCESS。
         子树独立黑板保存航点和索引；不负责起飞、跟踪、返航或降落。 -->
    <BehaviorTree ID="VisionRegionTraverse">
        <Sequence>
            <SetBlackboard output_key="result" value="failed" />
            <TraversePathGenerator origin_x="{origin_x}" origin_y="{origin_y}"
                            length_x="{length_x}" length_y="{length_y}"
                            coverage_step="{coverage_step}"
                            waypoints="{region_waypoints}"
                            waypoint_count="{region_waypoint_count}" />
            <SetBlackboard output_key="region_waypoint_index" value="0" />
            <!-- 命中时记录搜索结果，并 halt 正在运行的导航。 -->
            <ReactiveFallback>
                <Sequence>
                    <FoundCheck topic="/aruco_center/is_found" />
                    <SetBlackboard output_key="result" value="found" />
                </Sequence>
                <Sequence>
                    <!-- 每轮取出一个航点；Nav 完成后再进入下一轮。 -->
                    <Repeat num_cycles="{region_waypoint_count}">
                        <Sequence>
                            <GetRegionWaypoint waypoints="{region_waypoints}"
                                               index="{region_waypoint_index}"
                                               next_index="{region_waypoint_index}"
                                               x="{region_target_x}" y="{region_target_y}" />
                            <Nav x="{region_target_x}" y="{region_target_y}" z="{altitude}" tolerance="0.15" timeout="45.0" />
                        </Sequence>
                    </Repeat>
                    <SetBlackboard output_key="result" value="complete" />
                </Sequence>
            </ReactiveFallback>
        </Sequence>
    </BehaviorTree>
</root>
