<root>
    <!-- 每段导航至少启动一次后才允许中断。导航与处理阶段分离，确保 halt 已写入断点。
         target_armed 跨航段共享；可见性检查只读，发现时只检查历史，Guidance 成功后才记录已处理 ID。
         任一返回导航或 Guidance 失败，立即向上返回 FAILURE。 -->
    <BehaviorTree ID="TargetInterruptCheck">
        <Fallback>
            <ForceFailure>
                <Sequence>
                    <Inverter><FoundCheck topic="/aruco_center/content" record="false" /></Inverter>
                    <SetBlackboard output_key="target_armed" value="true" />
                </Sequence>
            </ForceFailure>
            <BlackboardCheckBool value_A="{target_armed}" value_B="true" return_on_mismatch="FAILURE">
                <FoundCheck topic="/aruco_center/content" target_id="{detected_target_id}" />
            </BlackboardCheckBool>
        </Fallback>
    </BehaviorTree>
    <BehaviorTree ID="HandleNavBreakpoint">
        <BlackboardCheckBool value_A="{breakpoint_valid}" value_B="true" return_on_mismatch="FAILURE">
            <Sequence>
                <NavRaw name="ReturnBreakpointBeforeGuidance" x="{breakpoint_x}" y="{breakpoint_y}"
                     z="{breakpoint_z}" timeout="90.0" />
                <Guidance target_id="{detected_target_id}" tracking_duration="{tracking_duration}"
                          timeout="90.0" message="{guidance_message}" />
                <!-- 经纬度上报失败不阻断任务，仍继续返回断点。 -->
                <ForceSuccess>
                    <SendGeoPose />
                </ForceSuccess>
                <NavRaw name="ReturnBreakpointAfterGuidance" x="{breakpoint_x}" y="{breakpoint_y}"
                     z="{breakpoint_z}" timeout="90.0" />
            </Sequence>
        </BlackboardCheckBool>
    </BehaviorTree>
    <BehaviorTree ID="NavWithTargetHandling">
        <Sequence>
            <!-- 每轮仍使用同一目标。只有正常到达才成功；处理失败立即退出，不重试失败动作。 -->
            <RetryUntilSuccessful num_attempts="-1">
                <Sequence>
                    <Fallback>
                        <Sequence>
                            <SetBlackboard output_key="nav_started" value="false" />
                            <SetBlackboard output_key="interrupted" value="false" />
                            <SetBlackboard output_key="breakpoint_valid" value="false" />
                            <ReactiveFallback>
                                <BlackboardCheckBool value_A="{nav_started}" value_B="true" return_on_mismatch="FAILURE">
                                    <Sequence>
                                        <SubTreePlus ID="TargetInterruptCheck" target_armed="{target_armed}"
                                                      detected_target_id="{detected_target_id}" />
                                        <SetBlackboard output_key="target_armed" value="false" />
                                        <SetBlackboard output_key="interrupted" value="true" />
                                    </Sequence>
                                </BlackboardCheckBool>
                                <Sequence>
                                    <SetBlackboard output_key="nav_started" value="true" />
                                    <Nav name="SearchLeg" x="{x}" y="{y}" z="{z}" timeout="45.0"
                                         breakpoint_x="{breakpoint_x}" breakpoint_y="{breakpoint_y}"
                                         breakpoint_z="{breakpoint_z}" breakpoint_valid="{breakpoint_valid}" />
                                </Sequence>
                            </ReactiveFallback>
                            <BlackboardCheckBool value_A="{interrupted}" value_B="true" return_on_mismatch="SUCCESS">
                                <SubTreePlus ID="HandleNavBreakpoint" detected_target_id="{detected_target_id}"
                                             breakpoint_x="{breakpoint_x}" breakpoint_y="{breakpoint_y}"
                                             breakpoint_z="{breakpoint_z}" breakpoint_valid="{breakpoint_valid}"
                                             tracking_duration="{tracking_duration}" guidance_message="{guidance_message}" />
                            </BlackboardCheckBool>
                            <SetBlackboard output_key="leg_failed" value="false" />
                        </Sequence>
                        <SetBlackboard output_key="leg_failed" value="true" />
                    </Fallback>
                    <!-- 处理失败时停止循环，由循环外返回 FAILURE；中断处理成功则重启原航段。 -->
                    <Fallback>
                        <BlackboardCheckBool value_A="{leg_failed}" value_B="true" return_on_mismatch="FAILURE">
                            <AlwaysSuccess />
                        </BlackboardCheckBool>
                        <BlackboardCheckBool value_A="{interrupted}" value_B="false" return_on_mismatch="FAILURE">
                            <AlwaysSuccess />
                        </BlackboardCheckBool>
                    </Fallback>
                </Sequence>
            </RetryUntilSuccessful>
            <BlackboardCheckBool value_A="{leg_failed}" value_B="false" return_on_mismatch="FAILURE">
                <AlwaysSuccess />
            </BlackboardCheckBool>
        </Sequence>
    </BehaviorTree>
    <BehaviorTree ID="AzimuthFixNavWithTargetHandling">
        <Sequence>
            <!-- 每轮仍使用同一目标。只有正常到达才成功；处理失败立即退出，不重试失败动作。 -->
            <RetryUntilSuccessful num_attempts="-1">
                <Sequence>
                    <Fallback>
                        <Sequence>
                            <SetBlackboard output_key="nav_started" value="false" />
                            <SetBlackboard output_key="interrupted" value="false" />
                            <SetBlackboard output_key="breakpoint_valid" value="false" />
                            <ReactiveFallback>
                                <BlackboardCheckBool value_A="{nav_started}" value_B="true" return_on_mismatch="FAILURE">
                                    <Sequence>
                                        <SubTreePlus ID="TargetInterruptCheck" target_armed="{target_armed}"
                                                      detected_target_id="{detected_target_id}" />
                                        <SetBlackboard output_key="target_armed" value="false" />
                                        <SetBlackboard output_key="interrupted" value="true" />
                                    </Sequence>
                                </BlackboardCheckBool>
                                <Sequence>
                                    <SetBlackboard output_key="nav_started" value="true" />
                                    <AzimuthFixNav name="SearchLeg" nav_n="{nav_n}" nav_t="{nav_t}" nav_a="{nav_a}" bp_x_raw="{bp_x_raw}" bp_y_raw="{bp_y_raw}" bp_z_raw="{bp_z_raw}" timeout="60.0"
                                         breakpoint_x="{breakpoint_x}" breakpoint_y="{breakpoint_y}"
                                         breakpoint_z="{breakpoint_z}" breakpoint_valid="{breakpoint_valid}" />
                                </Sequence>
                            </ReactiveFallback>
                            <BlackboardCheckBool value_A="{interrupted}" value_B="true" return_on_mismatch="SUCCESS">
                                <SubTreePlus ID="HandleNavBreakpoint" detected_target_id="{detected_target_id}"
                                             breakpoint_x="{breakpoint_x}" breakpoint_y="{breakpoint_y}"
                                             breakpoint_z="{breakpoint_z}" breakpoint_valid="{breakpoint_valid}"
                                             tracking_duration="{tracking_duration}" guidance_message="{guidance_message}" />
                            </BlackboardCheckBool>
                            <SetBlackboard output_key="leg_failed" value="false" />
                        </Sequence>
                        <SetBlackboard output_key="leg_failed" value="true" />
                    </Fallback>
                    <!-- 处理失败时停止循环，由循环外返回 FAILURE；中断处理成功则重启原航段。 -->
                    <Fallback>
                        <BlackboardCheckBool value_A="{leg_failed}" value_B="true" return_on_mismatch="FAILURE">
                            <AlwaysSuccess />
                        </BlackboardCheckBool>
                        <BlackboardCheckBool value_A="{interrupted}" value_B="false" return_on_mismatch="FAILURE">
                            <AlwaysSuccess />
                        </BlackboardCheckBool>
                    </Fallback>
                </Sequence>
            </RetryUntilSuccessful>
            <BlackboardCheckBool value_A="{leg_failed}" value_B="false" return_on_mismatch="FAILURE">
                <AlwaysSuccess />
            </BlackboardCheckBool>
        </Sequence>
    </BehaviorTree>
    <BehaviorTree ID="LaLoNavWithTargetHandling">
        <Sequence>
            <!-- 每轮仍使用同一目标。只有正常到达才成功；处理失败立即退出，不重试失败动作。 -->
            <RetryUntilSuccessful num_attempts="-1">
                <Sequence>
                    <Fallback>
                        <Sequence>
                            <SetBlackboard output_key="nav_started" value="false" />
                            <SetBlackboard output_key="interrupted" value="false" />
                            <SetBlackboard output_key="breakpoint_valid" value="false" />
                            <ReactiveFallback>
                                <BlackboardCheckBool value_A="{nav_started}" value_B="true" return_on_mismatch="FAILURE">
                                    <Sequence>
                                        <SubTreePlus ID="TargetInterruptCheck" target_armed="{target_armed}"
                                                      detected_target_id="{detected_target_id}" />
                                        <SetBlackboard output_key="target_armed" value="false" />
                                        <SetBlackboard output_key="interrupted" value="true" />
                                    </Sequence>
                                </BlackboardCheckBool>
                                <Sequence>
                                    <SetBlackboard output_key="nav_started" value="true" />
                                    <LaLoNav name="SearchLeg" latitude="{latitude}" longitude="{longitude}" timeout="90.0"
                                         breakpoint_x="{breakpoint_x}" breakpoint_y="{breakpoint_y}"
                                         breakpoint_z="{breakpoint_z}" breakpoint_valid="{breakpoint_valid}" />
                                </Sequence>
                            </ReactiveFallback>
                            <BlackboardCheckBool value_A="{interrupted}" value_B="true" return_on_mismatch="SUCCESS">
                                <SubTreePlus ID="HandleNavBreakpoint" detected_target_id="{detected_target_id}"
                                             breakpoint_x="{breakpoint_x}" breakpoint_y="{breakpoint_y}"
                                             breakpoint_z="{breakpoint_z}" breakpoint_valid="{breakpoint_valid}"
                                             tracking_duration="{tracking_duration}" guidance_message="{guidance_message}" />
                            </BlackboardCheckBool>
                            <SetBlackboard output_key="leg_failed" value="false" />
                        </Sequence>
                        <SetBlackboard output_key="leg_failed" value="true" />
                    </Fallback>
                    <!-- 处理失败时停止循环，由循环外返回 FAILURE；中断处理成功则重启原航段。 -->
                    <Fallback>
                        <BlackboardCheckBool value_A="{leg_failed}" value_B="true" return_on_mismatch="FAILURE">
                            <AlwaysSuccess />
                        </BlackboardCheckBool>
                        <BlackboardCheckBool value_A="{interrupted}" value_B="false" return_on_mismatch="FAILURE">
                            <AlwaysSuccess />
                        </BlackboardCheckBool>
                    </Fallback>
                </Sequence>
            </RetryUntilSuccessful>
            <BlackboardCheckBool value_A="{leg_failed}" value_B="false" return_on_mismatch="FAILURE">
                <AlwaysSuccess />
            </BlackboardCheckBool>
        </Sequence>
    </BehaviorTree>
</root>
