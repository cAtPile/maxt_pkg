<root>
    <include path="NavGeoTree.xml" />
    <BehaviorTree ID="PolygonCoverageTree">
        <Sequence>
            <PolygonCoverageWpG Longitude1="{Longitude1}" Latitude1="{Latitude1}"
                                Longitude2="{Longitude2}" Latitude2="{Latitude2}"
                                Longitude3="{Longitude3}" Latitude3="{Latitude3}"
                                Longitude4="{Longitude4}" Latitude4="{Latitude4}"
                                coverage_step="{coverage_step}" work_hight="{work_hight}"
                                waypoints="{path}" waypoint_count="{count}" z="{height}"/>
            <SetBlackboard output_key="index" value="0"/>
            <Repeat num_cycles="{count}">
                <Sequence>
                    <GetRegionWaypoint waypoints="{path}" index="{index}" next_index="{index}" x="{longitude}" y="{latitude}"/>
                    <SubTreePlus ID="NavGeoTree" Longitude="{longitude}" Latitude="{latitude}" Hight="{height}"/>
                </Sequence>
            </Repeat>
        </Sequence>
    </BehaviorTree>
</root>
