<root main_tree_to_execute="UgvCoworkTest">
    <include path="subtree/VisionRegionTraverse.xml" />
    <BehaviorTree ID="UgvCoworkTest">
        <Sequence>
            <ConnectCheck />
            <!-- 保存实际起飞 XY 与起飞点上方 4m 的返航高度。 -->
            <CapturePose height_offset="4.0"
                         x="{home_x}" y="{home_y}" z="{return_z}" />
            <Takeoff target_alt="4.0" />
            <SetBlackboard output_key="cowork_result" value="not_found" />
            <!-- 搜索/协同失败也返航；黑板保留具体阶段结果。 -->
            <ForceSuccess>
                <Sequence>
                    <SetBlackboard output_key="cowork_result" value="search_failed" />
                    <SubTreePlus ID="VisionRegionTraverse"
                             origin_x="0" origin_y="0" length_x="-6" length_y="6"
                             coverage_step="1" altitude="{return_z}"
                             result="{region_search_result}" />
                    <Switch2 variable="{region_search_result}" case_1="found" case_2="complete">
                        <Sequence>
                            <SetBlackboard output_key="cowork_result" value="alignment_failed" />
                            <!-- 先对齐，再让小车跟随无人机，避免使用刚发现目标时的偏离位置。 -->
                            <Guidance target_id="0" tracking_duration="0.0"
                                      timeout="45.0" message="{alignment_message}" />
                            <SetBlackboard output_key="cowork_result" value="cowork_failed" />
                            <Parallel success_threshold="1" failure_threshold="1">
                                <!-- 成功被装饰为 RUNNING，只有小车成功才能结束并行阶段。
                                     小车超时 90s，短于本轮跟踪时长 120s。 -->
                                <KeepRunningUntilFailure>
                                    <Guidance target_id="0" tracking_duration="120.0"
                                              timeout="150.0" message="{guidance_message}" />
                                </KeepRunningUntilFailure>
                                <UgvCowork follow_drone="true" timeout="90.0"
                                           update_period="0.2" target_tolerance="0.2"
                                           settle_time="1.0" message="{ugv_message}" />
                            </Parallel>
                            <SetBlackboard output_key="cowork_result" value="ugv_reached" />
                        </Sequence>
                        <Sequence>
                            <SetBlackboard output_key="cowork_result" value="not_found" />
                            <AlwaysSuccess />
                        </Sequence>
                        <AlwaysFailure />
                    </Switch2>
                </Sequence>
            </ForceSuccess>
            <!-- 使用 Nav 返航；返航失败时不执行后续降落。 -->
            <Nav name="ReturnHome" x="{home_x}" y="{home_y}" z="{return_z}"
                  tolerance="0.15" timeout="90.0" />
            <TouchDown />
        </Sequence>
    </BehaviorTree>
</root>
