<root main_tree_to_execute="FastMission">
    <BehaviorTree ID="FastMission">
        <Sequence>
            <ConnectCheck/>
            <!--起飞-->
            <Takeoff target_alt="0.5"/>
            <Nav x="0" y="0" z="2"/>

            <Nav x="1" y="1" z="2" timeout="60.0"/>
            <Hover hover_duration="1.0" />

            <BasePointAzimuthFix bp_x_raw="{bp_x_raw}" bp_y_raw="{bp_y_raw}" bp_z_raw="{bp_z_raw}"/>
            <AzimuthFixNav nav_n="1" nav_t="0" nav_a="0" bp_x_raw="{bp_x_raw}" bp_y_raw="{bp_y_raw}" bp_z_raw="{bp_z_raw}"/>
            <Hover hover_duration="3.0" />

            <AzimuthFixNav nav_n="0" nav_t="1" nav_a="0" bp_x_raw="{bp_x_raw}" bp_y_raw="{bp_y_raw}" bp_z_raw="{bp_z_raw}"/>
            <Hover hover_duration="3.0" />

            <!--降落-->
            <Nav x="0" y="0" z="0.5"/>
            <TouchDown/>
        </Sequence>
    </BehaviorTree>
</root>
