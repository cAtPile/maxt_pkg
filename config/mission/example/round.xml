<root main_tree_to_execute="RoundTrip">
    <BehaviorTree ID="RoundTrip">
        <Sequence>
            <ConnectCheck timeout="30" />
            <Takeoff target_alt="1.3" ascent_speed="0.5" timeout="30" />
            <QuinticNav x="1.0" y="0.0" z="1.3"
                        timeout="20" tolerance="0.1"
                        v_max="1.5" a_max="0.8" />
            <Hover hover_duration="1.0" />
            <Round center_x="2.0" center_y="0.0" center_z="1.3"
                   radius="1.0" angular_speed="30.0" total_angle="360.0"
                   tolerance="0.1" timeout="60" ramp_time="2.0" />
            <Hover hover_duration="1.0" />
            <QuinticNav x="0.0" y="0.0" z="1.3"
                        timeout="20" tolerance="0.1"
                        v_max="1.5" a_max="0.8" />
            <TouchDown descent_speed="-0.5" timeout="60"
                       ground_timeout="3.0" />
        </Sequence>
    </BehaviorTree>
</root>
