<root main_tree_to_execute="AllBasic">
    <BehaviorTree ID="AllBasic">
        <Sequence>
            <ConnectCheck timeout="30" />
            <Takeoff target_alt="1.3" ascent_speed="0.5" timeout="30" />
            <WaitStep wait_duration="0.5" />
            <Hover hover_duration="0.5" />
            <GoTo x="0.7" y="0.0" z="1.3"
                  timeout="20" tolerance="0.1" step="0.5" />
            <QuinticNav x="1.5" y="0.0" z="1.3"
                        timeout="20" tolerance="0.1"
                        v_max="1.5" a_max="0.8" />
            <Round center_x="1.5" center_y="1.0" center_z="1.3"
                   radius="1.0" angular_speed="60.0" total_angle="360.0"
                   tolerance="0.1" timeout="30" ramp_time="1.0" />
            <GoTo x="0.0" y="0.0" z="1.3"
                  timeout="20" tolerance="0.1" step="0.5" />
            <TouchDown descent_speed="-0.5" timeout="60"
                       ground_timeout="1.0" />
        </Sequence>
    </BehaviorTree>
</root>
