<root main_tree_to_execute="BoustrophedonMission">
    <include path="subtree/BoustrophedonTree.xml" />
    <BehaviorTree ID="BoustrophedonMission">
        <Sequence>
            <!-- 经纬度单位为度。矩形边长、航带间距和相对高度单位为米。 -->
            <SetBlackboard output_key="work_alt" value="填写" />
            <SetBlackboard output_key="base_Longitude" value="填写" />
            <SetBlackboard output_key="base_Latitude" value="填写" />
            <SetBlackboard output_key="heading_yaw" value="填写" />
            <SetBlackboard output_key="coverage_step" value="填写" />
            <SetBlackboard output_key="lenth_n" value="填写" />
            <SetBlackboard output_key="lenth_e" value="填写" />

            <ConnectCheck />
            <Takeoff target_alt="{work_alt}" home_raw_x="{home_raw_x}" home_raw_y="{home_raw_y}"
                     home_raw_z="{home_raw_z}" return_z="{return_z}" />
            <SubTreePlus ID="BoustrophedonTree" base_Longitude="{base_Longitude}" base_Latitude="{base_Latitude}"
                         lenth_n="{lenth_n}" lenth_e="{lenth_e}" coverage_step="{coverage_step}"
                         heading_yaw="{heading_yaw}" target_hight="{work_alt}" home_raw_z="{home_raw_z}" />
            <NavRaw name="ReturnHome" x="{home_raw_x}" y="{home_raw_y}" z="{return_z}" />
            <TouchDown />
        </Sequence>
    </BehaviorTree>
</root>
