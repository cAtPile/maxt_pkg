<launch>
  <arg name="gui" default="true"/>
  <arg name="world" default="$(find mavlink_sitl_gazebo)/worlds/empty.world"/>
  <arg name="vehicle" default="rover"/>
  <arg name="x" default="0"/>
  <arg name="y" default="0"/>
  <arg name="z" default="0.2"/>
  <arg name="yaw" default="0"/>
  <arg name="speed" default="0.5"/>
  <arg name="duration" default="5.0"/>
  <arg name="heading_deg" default="0.0"/>
  <arg name="run_control" default="true"/>
  <arg name="use_goal" default="true"/>
  <arg name="goal_x" default="3.0"/>
  <arg name="goal_y" default="3.0"/>
  <arg name="tolerance" default="0.2"/>
  <arg name="legacy_rover_velocity" default="true"/>
  <arg name="fcu_url" default="udp://:14540@127.0.0.1:14557"/>
  <include file="$(find px4)/launch/posix_sitl.launch">
    <arg name="vehicle" value="$(arg vehicle)"/>
    <arg name="world" value="$(arg world)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="x" value="$(arg x)"/>
    <arg name="y" value="$(arg y)"/>
    <arg name="z" value="$(arg z)"/>
    <arg name="Y" value="$(arg yaw)"/>
    <arg name="interactive" value="false"/>
    <arg name="respawn_gazebo" value="false"/>
  </include>
  <include file="$(find mavros)/launch/px4.launch">
    <arg name="fcu_url" value="$(arg fcu_url)"/>
    <arg name="gcs_url" value=""/>
  </include>
  <include if="$(arg run_control)" file="$(find maxt_pkg)/ugv_demo/ugv_demo.launch">
    <arg name="speed" value="$(arg speed)"/>
    <arg name="duration" value="$(arg duration)"/>
    <arg name="heading_deg" value="$(arg heading_deg)"/>
    <arg name="use_goal" value="$(arg use_goal)"/>
    <arg name="goal_x" value="$(arg goal_x)"/>
    <arg name="goal_y" value="$(arg goal_y)"/>
    <arg name="tolerance" value="$(arg tolerance)"/>
    <arg name="legacy_rover_velocity" value="$(arg legacy_rover_velocity)"/>
  </include>
</launch>
