<launch>
  <arg name="config" default="$(find maxt_pkg)/ugv_demo/config/ugv_move.yaml"/>
  <arg name="profile" default=""/>
  <arg name="run_controller" default="true"/>
  <arg name="action_name" default="/ugv_mover"/>
  <arg name="mavros_ns" default="/mavros"/>
  <arg name="speed" default="0.5"/>
  <arg name="tolerance" default="0.2"/>
  <arg name="goal_timeout" default="120.0"/>
  <arg name="legacy_rover_velocity" default="true"/>
  <node pkg="maxt_pkg" type="ugv_move_demo.py" name="ugv_move_demo" output="screen">
    <param name="action_name" value="$(arg action_name)"/>
    <param name="mavros_ns" value="$(arg mavros_ns)"/>
    <param name="speed" value="$(arg speed)"/>
    <param name="tolerance" value="$(arg tolerance)"/>
    <param name="goal_timeout" value="$(arg goal_timeout)"/>
    <param name="legacy_rover_velocity" value="$(arg legacy_rover_velocity)"/>
  </node>
  <node if="$(arg run_controller)" pkg="maxt_pkg" type="ugv_move_controller.py"
        name="ugv_move_controller" output="screen">
    <rosparam command="load" file="$(arg config)"/>
    <param name="action_name" value="$(arg action_name)"/>
    <param if="$(eval arg('profile') != '')" name="profile" value="$(arg profile)"/>
  </node>
</launch>
