<launch>
    <arg name="sim" default="true" />
    <arg name="run_uav" default="false" />
    <arg name="nav_config" default="$(find maxt_pkg)/config/test_1114.yaml" />
    <include file="$(find maxt_pkg)/launch/mission.launch">
        <arg name="bt_xml_path" value="$(find maxt_pkg)/config/mission/test_1114_b.xml" />
        <arg name="nav_config" value="$(arg nav_config)" />
        <arg name="sim" value="$(arg sim)" />
        <arg name="run_uav" value="$(arg run_uav)" />
    </include>
</launch>
