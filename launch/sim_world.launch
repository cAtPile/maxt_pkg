<launch>
  <arg name="world" default="$(find maxt_pkg)/worlds/tracking_test.world"/>
  <arg name="gui" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="move_target" default="true"/>
  <arg name="target_x" default="3.0"/>
  <arg name="target_y" default="0.0"/>
  <arg name="target_z" default="1.5"/>
  <arg name="amplitude" default="2.0"/>
  <arg name="period" default="12.0"/>
  <arg name="rate" default="30.0"/>
  <!-- Preserve model paths supplied by other simulation packages. -->
  <env name="GAZEBO_MODEL_PATH" value="$(find maxt_pkg)/models:$(optenv GAZEBO_MODEL_PATH)"/>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="true"/>
  </include>
  <node if="$(arg move_target)" pkg="maxt_pkg" type="moving_target.py" name="moving_target" output="screen">
    <param name="x" value="$(arg target_x)"/><param name="y" value="$(arg target_y)"/><param name="z" value="$(arg target_z)"/>
    <param name="amplitude" value="$(arg amplitude)"/><param name="period" value="$(arg period)"/><param name="rate" value="$(arg rate)"/>
  </node>
  <!-- World -> optical: camera +X forward becomes optical +Z forward. -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="tracking_camera_tf"
        args="-5 0 1.5 -1.57079632679 0 -1.57079632679 world tracking_camera_optical_frame"/>
</launch>
