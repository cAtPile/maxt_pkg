<launch>
  <arg name="world" default="$(find maxt_pkg)/worlds/tracking_test.world"/>
  <arg name="gui" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="move_target" default="true"/>
  <arg name="target_x" default="-2.0"/>
  <arg name="target_y" default="2.0"/>
  <arg name="target_z" default="0.02"/>
  <arg name="amplitude" default="2.0"/>
  <arg name="period" default="12.0"/>
  <arg name="config" default="$(find maxt_pkg)/config/sim_world.yaml"/>
  <!-- Compatibility argument; native motion now updates every physics step. -->
  <arg name="rate" default="30.0"/>
  <!-- Preserve model paths supplied by other simulation packages. -->
  <env name="GAZEBO_MODEL_PATH" value="$(find maxt_pkg)/models:$(optenv GAZEBO_MODEL_PATH)"/>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="true"/>
  </include>
  <!-- The model plugin reads these once, then updates on each physics step. -->
  <group ns="moving_target">
    <param name="enabled" value="$(arg move_target)"/>
    <param name="x" value="$(arg target_x)"/>
    <param name="y" value="$(arg target_y)"/>
    <param name="z" value="$(arg target_z)"/>
    <param name="amplitude" value="$(arg amplitude)"/>
    <param name="period" value="$(arg period)"/>
    <rosparam command="load" file="$(arg config)"/>
  </group>
</launch>
